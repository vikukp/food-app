{
  "name": "iwf-food-court",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-secret.mjs --dev && prisma generate && prisma db push && prisma db seed -- --dev && next dev --hostname 0.0.0.0 --port 43123",
    "build": "node scripts/ensure-secret.mjs && prisma generate && prisma db push && prisma db seed && next build",
    "start": "node scripts/ensure-secret.mjs && node server.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node e2e/run.mjs",
    "db:setup": "node scripts/ensure-secret.mjs && prisma generate && prisma db push && prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/env": "16.3.5",
    "@prisma/client": "^6.19.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
