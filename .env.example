# SQLite database used by Prisma.
DATABASE_URL="file:./dev.db"

# 32+ random characters. Signs sessions, sign-in codes and QR payloads. If unset,
# the npm scripts generate one into .env.local on first run.
# SESSION_SECRET=

# Demo conveniences: sign-in codes on screen, shared counter PIN, demo employee.
# Off unless set; `npm run dev` turns it on in .env.local. Never in production.
# DEMO_MODE=1

# PIN every new stall starts with in demo mode (default 1234). Outside demo mode
# each new stall gets a random PIN printed by the seed, unless this is set.
# DEMO_VENDOR_PIN=1234

# Mobile numbers of food court managers who can open /admin (comma-separated).
# By phone, not employee ID: IDs are typed in at registration and not verified.
# ADMIN_PHONES=9845012345,9845067890

# Reverse proxies in front of `npm start` whose X-Forwarded-For can be trusted.
# 0 (default) when browsers connect directly; 1 behind one proxy/load balancer.
# TRUST_PROXY_HOPS=0

# How sign-in codes are delivered. Use "twilio" for real SMS. Unset or "demo"
# shows the code on screen (anyone can sign in as any number) only with
# DEMO_MODE=1; otherwise codes are refused.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Either a sender number or a messaging service:
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Regional edge or a test stub; defaults to https://api.twilio.com
# TWILIO_API_BASE=

# Most sign-in texts per rolling 24 hours across the whole app.
# OTP_DAILY_LIMIT=2000

# AI ordering assistant (README, AI ordering assistant). Off until AI_API_KEY is set.
# AI_API_KEY=
# anthropic (default), openai, openrouter, vercel, litellm, cloudflare, portkey or custom:
# AI_ROUTER=anthropic
# Defaults: claude-opus-5-5 (anthropic, cloudflare), gpt-6.1-sol (openai); required for the rest:
# AI_MODEL=claude-opus-5-5
# Required for litellm, cloudflare and custom:
# AI_BASE_URL=
# AI_HEADERS='{"cf-aig-authorization": "Bearer ..."}'
# AI_EFFORT=low
# AI_DAILY_LIMIT=30
# AI_TOTAL_DAILY_LIMIT=2000

# Name and logo of this copy (README, Branding). Defaults: Campus Food Court,
# Food Court, brand/logo.svg, #0b3d32.
# BRAND_NAME="Acme Pune Food Court"
# BRAND_SHORT_NAME="Food Court"
# Square SVG or PNG, 512px or larger, up to 1 MB:
# BRAND_LOGO=/srv/acme/logo.png
# Colour around the logo on home-screen icons (quoted: # starts a comment):
# BRAND_LOGO_BACKGROUND="#0b3d32"
