generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Relative paths are relative to this folder. Defaults to file:./dev.db
  // (written to .env by scripts/ensure-secret.mjs); Docker points it at a volume.
  url      = env("DATABASE_URL")
}

model Stall {
  id          String     @id
  name        String
  cuisine     String
  description String
  location    String
  openTime    String
  closeTime   String
  vegOnly     Boolean    @default(false)
  // Set by the stall to stop new orders for a while (rush, out of gas, ...).
  paused      Boolean    @default(false)
  // Shown on receipts. Optional until the stall adds it.
  gstin       String?
  // Orders the counter can hand over per 15-minute pickup slot; full slots are not offered.
  slotCapacity Int       @default(12)
  // Usual minutes from "Start preparing" to ready, for wait estimates.
  prepMinutes Int        @default(10)
  busyLevel   String
  vendorPinHash String
  // Bumped on PIN change; vendor sessions carrying an older value stop working.
  sessionVersion Int     @default(0)
  accent      String
  items       MenuItem[]
  orders      Order[]
}

model MenuItem {
  id          String      @id
  stallId     String
  stall       Stall       @relation(fields: [stallId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceInr    Int
  offerPriceInr Int?
  offerLabel  String?
  veg         Boolean
  // Non-veg only because of egg (no meat or fish); shown as "Egg".
  egg         Boolean     @default(false)
  // No onion, garlic or root vegetables. Only meaningful for veg items.
  jain        Boolean     @default(false)
  // Comma-separated ids from src/lib/dietary.ts; empty means "not listed".
  allergens   String      @default("")
  kcal        Int?
  category    String
  available   Boolean     @default(true)
  archived    Boolean     @default(false)
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  // T-1000..T-9999, unique per stall per campus day so tokens never run out.
  token         String
  tokenDay      String      @default("")
  employeeId    String
  employeeName  String
  stallId       String
  stall         Stall       @relation(fields: [stallId], references: [id])
  status        String
  pickupSlot    String
  // When that slot actually is (pickupSlot is only "HH:MM"); capacity counts by it.
  pickupAt      DateTime?
  paymentMethod String
  paymentRef    String
  totalInr      Int
  // Orders paid for together from one bag (one per stall) share this.
  checkoutId    String?
  // Optional note for the kitchen, e.g. "less spicy".
  note          String?
  // Set when status is CANCELLED: "employee" or "stall", and why (stall only).
  cancelledBy   String?
  cancelReason  String?
  // Optional feedback once collected: 1-5 and a short comment.
  rating        Int?
  ratingComment String?
  ratedAt       DateTime?
  // When each step happened, for the ticket's timeline and "waiting at the counter".
  preparingAt   DateTime?
  readyAt       DateTime?
  collectedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@unique([stallId, tokenDay, token])
  @@index([stallId, ratedAt])
  @@index([stallId, pickupAt])
  @@index([employeeId])
  @@index([checkoutId])
  @@index([stallId, status])
  @@index([stallId, updatedAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  qty        Int
  priceInr   Int
  veg        Boolean
}

model Employee {
  id             String    @id @default(cuid())
  employeeId     String    @unique
  name           String
  // E.164, e.g. +919845012345
  phone          String    @unique
  pinHash        String
  // Five wrong PINs within 30 minutes lock PIN sign-in until the window runs
  // out or the employee signs in with a code.
  pinFailedCount Int       @default(0)
  // Start of the current failure window: the first wrong PIN after a reset.
  pinFailedAt    DateTime?
  // Lockouts that ran out since the last successful sign-in. The third lockout
  // does not run out: it needs a code sign-in.
  pinLockouts    Int       @default(0)
  // Bumped on PIN reset; sessions carrying an older value stop working.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OtpChallenge {
  id         String    @id
  phone      String
  purpose    String
  codeHash   String
  // Only set when SMS_PROVIDER is demo, so the code can be shown on screen.
  demoCode   String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([createdAt])
}
