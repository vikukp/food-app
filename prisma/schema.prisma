generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Relative paths are relative to this folder. Defaults to file:./dev.db
  // (written to .env by scripts/ensure-secret.mjs); Docker points it at a volume.
  url      = env("DATABASE_URL")
}

model Stall {
  id          String     @id
  name        String
  cuisine     String
  description String
  location    String
  openTime    String
  closeTime   String
  vegOnly     Boolean    @default(false)
  // Set by the stall to stop new orders for a while (rush, out of gas, ...).
  paused      Boolean    @default(false)
  // Orders the counter can hand over per 15-minute pickup slot; full slots are not offered.
  slotCapacity Int       @default(12)
  // Usual minutes from "Start preparing" to ready, for wait estimates.
  prepMinutes Int        @default(10)
  busyLevel   String
  vendorPinHash String
  // Bumped on PIN change; vendor sessions carrying an older value stop working.
  sessionVersion Int     @default(0)
  accent      String
  items       MenuItem[]
  orders      Order[]
}

model MenuItem {
  id          String      @id
  stallId     String
  stall       Stall       @relation(fields: [stallId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceInr    Int
  offerPriceInr Int?
  offerLabel  String?
  veg         Boolean
  category    String
  available   Boolean     @default(true)
  archived    Boolean     @default(false)
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  // IWF-1000..IWF-9999, unique per stall per campus day so tokens never run out.
  token         String
  tokenDay      String      @default("")
  employeeId    String
  employeeName  String
  stallId       String
  stall         Stall       @relation(fields: [stallId], references: [id])
  status        String
  pickupSlot    String
  paymentMethod String
  paymentRef    String
  totalInr      Int
  // Set when status is CANCELLED: "employee" or "stall", and why (stall only).
  cancelledBy   String?
  cancelReason  String?
  // When each step happened, for the ticket's timeline and "waiting at the counter".
  preparingAt   DateTime?
  readyAt       DateTime?
  collectedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@unique([stallId, tokenDay, token])
  @@index([employeeId])
  @@index([stallId, status])
  @@index([stallId, updatedAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  qty        Int
  priceInr   Int
  veg        Boolean
}

model Employee {
  id             String    @id @default(cuid())
  employeeId     String    @unique
  name           String
  // E.164, e.g. +919845012345
  phone          String    @unique
  pinHash        String
  // Five wrong PINs within 30 minutes lock PIN sign-in until the window runs
  // out or the employee signs in with a code.
  pinFailedCount Int       @default(0)
  // Start of the current failure window: the first wrong PIN after a reset.
  pinFailedAt    DateTime?
  // Lockouts that ran out since the last successful sign-in. The third lockout
  // does not run out: it needs a code sign-in.
  pinLockouts    Int       @default(0)
  // Bumped on PIN reset; sessions carrying an older value stop working.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OtpChallenge {
  id         String    @id
  phone      String
  purpose    String
  codeHash   String
  // Only set when SMS_PROVIDER is demo, so the code can be shown on screen.
  demoCode   String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([createdAt])
}
